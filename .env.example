# Supabase (KOINA project — separate from JustVibing / Oshikatsu)
# Create a new project at https://supabase.com, then paste credentials below.
NEXT_PUBLIC_SUPABASE_URL=https://your-koina-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL used for confirmation emails + server-side redirects
# Production: https://koina.space (or your domain)
# Local: http://localhost:3000
# Keep this host in Supabase Auth → URL Configuration → Redirect URLs:
#   http://localhost:3000/auth/callback
#   https://koina.space/auth/callback
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (registration confirmation emails)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=KOINA <noreply@koina.space>

# Optional: Discord bot (live chat bridge)
DISCORD_BOT_TOKEN=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_CHAT_WEBHOOK_URL=
DISCORD_GUILD_ID=
CRON_SECRET=change-me

# Optional: Roblox Open Cloud (only if you re-enable game score sync)
ROBLOX_OPEN_CLOUD_API_KEY=
